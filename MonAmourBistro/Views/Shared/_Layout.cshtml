@using MonAmourBistro.Controllers
@{
    var isHome = ViewData["IsHome"] as bool? ?? false;
    var role = Sim.Current(Context);
    var roleClass = "role-" + role.ToString().ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mon Amour Bistro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Josefin+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "home" : "inner")">
    <header class="site-header">
        <div class="topbar">
            <span>Chișinău, Moldova</span>
            <span class="sep">|</span>
            <span>Sună-ne: +373 000 00 000</span>
        </div>
        <div class="demo-bar">
            Mod demonstrație &middot; rol curent:
            <span class="role-badge @roleClass">@Sim.Label(role)</span>
            <a href="/roluri">Schimbă rolul / vezi accesul</a>
        </div>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-xl nav-row">
                <a class="navbar-brand brand" href="/">MON AMOUR<small>B I S T R O</small></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Meniu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav nav-left">
                        <li class="nav-item"><a class="nav-link" href="/">Acasă</a></li>
                        <li class="nav-item"><a class="nav-link" href="/meniu">Meniu</a></li>
                        <li class="nav-item"><a class="nav-link" href="/despre-noi">Despre noi</a></li>
                    </ul>
                    <ul class="navbar-nav nav-right">
                        <li class="nav-item"><a class="nav-link" href="/galerie">Galerie</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                        @if (role == SimRole.Vizitator)
                        {
                            <li class="nav-item"><a class="nav-link" href="/autentificare">Autentificare</a></li>
                        }
                        else if (role == SimRole.Client)
                        {
                            <li class="nav-item"><a class="nav-link" href="/cont">Contul meu</a></li>
                            <li class="nav-item"><a class="nav-link" href="/roluri/seteaza/vizitator?returnUrl=/">Ieșire</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
                            <li class="nav-item"><a class="nav-link" href="/roluri/seteaza/vizitator?returnUrl=/">Ieșire</a></li>
                        }
                    </ul>
                    <a href="/rezervare" class="btn-outline-light-x nav-cta">Rezervare</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (isHome)
        {
            @RenderBody()
        }
        else
        {
            <div class="container page-wrap">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="site-footer">
        <div class="container-xl text-center">
            <div class="brand-foot">MON AMOUR BISTRO</div>
            <p class="mb-2">Chișinău, Moldova &middot; +373 000 00 000 &middot; contact@monamourbistro.md</p>
            <p class="mb-0">
                &copy; 2026 Mon Amour Bistro &middot;
                <a href="/contact">Contact</a> &middot;
                <a href="/confidentialitate">Confidențialitate</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>